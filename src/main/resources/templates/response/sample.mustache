<!doctype html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>User Detail</title>
    <style>
        body{font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans KR', Arial; background:#f5f7fb; color:#222; padding:32px}
        .card{max-width:640px;margin:32px auto;padding:20px;background:#fff;border-radius:8px;box-shadow:0 6px 18px rgba(31,41,55,0.06)}
        h1{margin:0 0 12px;font-size:22px}
        dl{display:grid;grid-template-columns:120px 1fr;gap:8px 16px;margin:12px 0}
        dt{color:#6b7280}
        dd{margin:0}
        .actions{margin-top:18px}
        .btn{display:inline-block;padding:8px 12px;border-radius:6px;text-decoration:none;border:1px solid #e5e7eb}
        .btn.primary{background:#2563eb;color:#fff;border-color:transparent}
        .note{font-size:13px;color:#6b7280;margin-top:10px}
    </style>
</head>
<body>
<div class="card">
    <h1>사용자 정보</h1>
    <dl>
        <dt>ID</dt>
        <dd>{{#user.id}}{{user.id}}{{/user.id}}</dd>

        <dt>이름</dt>
        <dd>{{#user.name}}{{user.name}}{{/user.name}}</dd>

        <dt>이메일</dt>
        <dd>{{#user.email}}{{user.email}}{{/user.email}}</dd>

        <dt>나이</dt>
        <dd>{{#user.age}}{{user.age}}{{/user.age}}</dd>
    </dl>

</div>
</body>
</html>
