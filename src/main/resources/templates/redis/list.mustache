<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Redis List</title>
    <style>
        body { font-family: sans-serif; }
        h2 { color: #333; }
        ul { list-style-type: disc; margin-left: 20px; }
    </style>
</head>
<body>
<h2>List: 채팅 메시지</h2>

<!-- 메시지 목록 -->
<ul>
    {{#messages}}
        <li>{{.}}</li>
    {{/messages}}
    {{^messages}}
        <li>메시지가 없습니다.</li>
    {{/messages}}
</ul>

<!-- 메시지 입력 -->
<div>
    <label>메시지 입력: <input type="text" name="message" required id="message"></label><br><br>
    <label>
        <input type="radio" name="direction" value="R" checked > RPUSH (뒤에 추가)
    </label>
    <label>
        <input type="radio" name="direction" value="L"> LPUSH (앞에 추가)
    </label><br><br>
    <button type="submit" onclick=pushMessage()>추가</button>
</div>

</body>
</html>
<script>
    function pushMessage() {
        const message = document.getElementById("message").value;
        const direction = document.querySelector('input[name="direction"]:checked').value;

        fetch("/redis/list/push", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ message, direction })
        })
                .then(response => response.ok ? console.log("저장되었습니다.") : alert("저장 실패"))
                .catch(err => alert("오류 발생: " + err));
    }
</script>
