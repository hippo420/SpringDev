<!-- templates/redis/sortedset.mustache -->
<!DOCTYPE html>
<html>
<head><title>Redis Sorted Set</title></head>
<body>
<h2>Sorted Set: 리더보드</h2>
<table border="1">
    <tr><th>순위</th><th>사용자</th><th>점수</th></tr>
    {{#rankings}}
        <tr>
            <td>{{rank}}</td>
            <td>{{user}}</td>
            <td>{{score}}</td>
        </tr>
    {{/rankings}}
    {{^rankings}}
        <tr><td colspan="3">데이터 없음</td></tr>
    {{/rankings}}
</table>
</body>
</html>